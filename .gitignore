# ─────────────────────────────────────────────
# PoP-Mesh — .gitignore
# ─────────────────────────────────────────────

# ── Build outputs ────────────────────────────
/build/
/.gradle/
/bin/
out/

# ── Gradle wrapper cache ──────────────────────
.gradle/

# ── IDE files ────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.classpath
*.project
.settings/

# ── Secrets & Certificates ───────────────────
# NEVER commit private keys or PKCS12 keystores
*.key
*.p12
*.pem
*.jks
src/main/resources/certs/

# ── k6 results output ────────────────────────
results.json
results.csv
*.k6log
/result/
k6.exe

# ── Temporary Benchmark Scripts ──────────────
run_pipeline.ps1

# ── OS files ─────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────
*.log
logs/

# ── Spring Boot devtools restart ──────────────
.spring-boot-devtools.properties



# ── Dashboard (Node / Vite) ───────────────────
dashboard/node_modules/
dashboard/dist/
dashboard/.env*.local

# ── Showcase Generated Artifacts ─────────────
showcase/paper.md

# ── Python / Temporary ───────────────────────
__pycache__/
*.py[cod]
*$py.class
*.zip
*.tar.gz

